<?xml version="1.0" encoding="utf-8"?>
<!--
    The whole widget is one word and one mark. At a glance, from across a room,
    it answers the only question anyone asks of it (docs/DESIGN.md §4).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_plate"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_mark"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/tile_name"
        android:src="@drawable/ic_zales_mark" />

    <TextView
        android:id="@+id/widget_word"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFE6DCC6"
        android:textSize="20sp"
        android:textStyle="normal"
        />
</LinearLayout>
